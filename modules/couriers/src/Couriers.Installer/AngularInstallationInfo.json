{
  "packages":[
    {
      "appRoutingModuleConfiguration":{
        "imports":[
          {
            "names":[
              "COURIERS_ROUTES"
            ],
            "namespace": "@couriers"
          } 
        ],
        "routes":[
          "{ path: 'couriers', children: COURIERS_ROUTES, canActivate: [authGuard] }"
        ]
      },
      "appModuleConfiguration":{
        "imports":[
          {
            "names":[
              "provideCouriers"
            ],
            "namespace": "@couriers/config"
          }
        ],
        "providerNames":[
          "provideCouriers()"
        ]
      },
      "tsJsonPathRecordConfigurations":[
        {
          "name": "@couriers",
          "paths": [
            "angular/projects/couriers/src/public-api.ts"
          ]
        },
        {
          "name": "@couriers/config",
          "paths": [
            "angular/projects/couriers/config/src/public-api.ts"
          ]
        }
      ]
    }
  ]
}