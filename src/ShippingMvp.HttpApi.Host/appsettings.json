{
  "App": {
    "SelfUrl": "https://localhost:44363",
    "AngularUrl": "http://localhost:4200",
    "CorsOrigins": "https://*.ShippingMvp.com,http://localhost:4200,",
    "RedirectAllowedUrls": "http://localhost:4200,",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Server=.;Database=ShippingMvp;Trusted_Connection=True;TrustServerCertificate=true"
  },
  "AuthServer": {
    "Authority": "https://localhost:44363",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "ShippingMvp_Swagger",
    "CertificatePassPhrase": "468ed17b-3d79-4c43-963e-8027bf0736dc"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "yYhz7qwCf8uRQrqh"
  }}